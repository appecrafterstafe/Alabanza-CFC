<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ministerio de Alabanza</title>
  <!-- SortableJS para arrastrar y soltar -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
  <!-- Google Fonts: Plus Jakarta Sans (Tipografía moderna y limpia) -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Paleta basada en el verde menta del logo */
      --brand-mint: #6ee7b7;
      --brand-mint-glow: rgba(110, 231, 183, 0.25);
      --brand-mint-dark: #059669;
      
      --bg-dark: #07090e;
      --card-bg: rgba(18, 24, 38, 0.75);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-glow: rgba(110, 231, 183, 0.3);
      
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --danger: #f43f5e;
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(110, 231, 183, 0.12) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(10, 185, 129, 0.08) 0%, transparent 40%);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      max-width: 480px;
      margin: 0 auto;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.8);
    }

    /* Header estilizado con el Logo */
    header {
      padding: 1.2rem 1rem 0.8rem 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      background: transparent;
    }

    .app-logo {
      height: 38px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 8px var(--brand-mint-glow));
    }

    header h1 {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #ffffff 30%, var(--brand-mint) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Navegación inferior flotante con profundidad */
    nav {
      display: flex;
      background: rgba(10, 14, 23, 0.85);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--card-border);
      position: sticky;
      bottom: 0;
      z-index: 50;
      padding: 0.6rem;
      gap: 0.4rem;
    }

    nav button {
      flex: 1;
      padding: 0.65rem 0.2rem;
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.75rem;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      border-radius: 14px;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    nav button span.icon {
      font-size: 1.2rem;
    }

    nav button.active {
      color: #000;
      background: var(--brand-mint);
      font-weight: 700;
      box-shadow: 0 6px 16px var(--brand-mint-glow), inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    main {
      flex: 1;
      padding: 1rem;
      overflow-y: auto;
      padding-bottom: 2rem;
    }

    .tab-content {
      display: none;
      animation: tabSlide 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tab-content.active {
      display: block;
    }

    @keyframes tabSlide {
      from { opacity: 0; transform: translateY(8px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Buscador */
    .search-wrapper {
      position: relative;
      margin-bottom: 1.25rem;
    }

    .search-wrapper input {
      width: 100%;
      padding: 0.9rem 1rem 0.9rem 2.85rem;
      border-radius: var(--radius);
      border: 1px solid var(--card-border);
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      color: var(--text-main);
      font-size: 0.95rem;
      box-shadow: 0 8px 20px rgba(0,0,0,0.3);
      transition: all 0.25s;
    }

    .search-wrapper input:focus {
      outline: none;
      border-color: var(--brand-mint);
      box-shadow: 0 0 0 3px var(--brand-mint-glow), 0 8px 20px rgba(0,0,0,0.4);
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 1rem;
    }

    /* Tarjetas de Canciones */
    .song-card {
      background: var(--card-bg);
      backdrop-filter: blur(14px);
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 1rem;
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      transition: all 0.25s ease;
    }

    .song-card:active {
      transform: scale(0.98);
    }

    #sundayList .song-card {
      cursor: grab;
    }
    #sundayList .song-card:active {
      cursor: grabbing;
    }

    .song-info {
      flex: 1;
      min-width: 0;
      margin-right: 0.5rem;
    }

    .song-info h3 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.35rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .song-meta {
      display: flex;
      gap: 0.4rem;
      align-items: center;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.55rem;
      border-radius: 8px;
      font-size: 0.72rem;
      font-weight: 700;
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-muted);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .badge.key {
      background: rgba(110, 231, 183, 0.12);
      color: var(--brand-mint);
      border-color: rgba(110, 231, 183, 0.25);
    }

    .song-actions {
      display: flex;
      gap: 0.45rem;
      align-items: center;
    }

    .action-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.95rem;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
      transition: all 0.2s;
    }

    .action-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      transform: translateY(-2px);
    }

    .action-btn.star.active {
      color: #000;
      background: var(--brand-mint);
      border-color: var(--brand-mint);
      box-shadow: 0 4px 12px var(--brand-mint-glow);
    }

    .action-btn.danger:hover {
      background: rgba(244, 63, 94, 0.15);
      color: var(--danger);
      border-color: rgba(244, 63, 94, 0.3);
    }

    .drag-handle {
      color: var(--text-muted);
      font-size: 1.1rem;
      cursor: grab;
      padding: 0 0.3rem;
    }

    /* Formularios */
    .form-group {
      margin-bottom: 1.1rem;
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }

    .form-group input {
      width: 100%;
      padding: 0.9rem 1rem;
      border-radius: var(--radius);
      border: 1px solid var(--card-border);
      background: var(--card-bg);
      color: var(--text-main);
      font-size: 0.95rem;
      box-shadow: 0 6px 16px rgba(0,0,0,0.2);
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--brand-mint);
      box-shadow: 0 0 0 3px var(--brand-mint-glow);
    }

    button.btn-primary {
      width: 100%;
      padding: 1rem;
      border-radius: var(--radius);
      background: linear-gradient(135deg, var(--brand-mint) 0%, #34d399 100%);
      color: #000;
      font-weight: 800;
      font-size: 0.95rem;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 20px var(--brand-mint-glow);
      transition: all 0.2s;
      margin-top: 0.5rem;
    }

    button.btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 25px var(--brand-mint-glow);
    }

    /* Visor Drive */
    .drive-container {
      width: 100%;
      height: calc(100vh - 140px);
      border: none;
      border-radius: var(--radius);
      background-color: var(--card-bg);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 800;
      margin-bottom: 0.3rem;
      color: var(--text-main);
    }

    /* Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.92);
      backdrop-filter: blur(12px);
      z-index: 100;
      flex-direction: column;
    }

    .modal-header {
      padding: 1rem;
      background: rgba(10, 14, 23, 0.95);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--card-border);
    }

    .modal-header h3 {
      font-size: 0.95rem;
      font-weight: 700;
      max-width: 60%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .modal-header-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .modal-body {
      flex: 1;
      width: 100%;
      background: #000;
    }

    .modal-body iframe {
      width: 100%;
      height: 100%;
      border: none;
    }

    .close-btn {
      background: rgba(255, 255, 255, 0.08);
      border: none;
      color: var(--text-main);
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .btn-small {
      padding: 0.45rem 0.85rem;
      font-size: 0.8rem;
      border-radius: 10px;
      border: 1px solid var(--card-border);
      cursor: pointer;
      font-weight: 700;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-main);
      transition: all 0.2s;
    }

    .btn-small.active {
      background: var(--brand-mint);
      color: #000;
      border-color: var(--brand-mint);
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-muted);
    }
    .empty-state span {
      font-size: 2.5rem;
      display: block;
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body>

  <!-- ENCABEZADO CON LOGO -->
  <header>
    <img src="logo.png" alt="Logo Ministerio" class="app-logo">
    <h1>Ministerio de Alabanza</h1>
  </header>

  <main>
    <!-- TAB REPERTORIO -->
    <section id="repertorio" class="tab-content active">
      <div class="search-wrapper">
        <span class="search-icon">🔍</span>
        <input type="text" id="searchInput" placeholder="Buscar canción o tono..." oninput="filterSongs()">
      </div>
      <div id="songsList"></div>
    </section>

    <!-- TAB DOMINGO -->
    <section id="domingo" class="tab-content">
      <h2 class="section-title">Repertorio del Domingo</h2>
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.25rem;">Arrastra desde las barras para ordenar la reunión.</p>
      <div id="sundayList"></div>
    </section>

    <!-- TAB DRIVE -->
    <section id="drive" class="tab-content">
      <iframe class="drive-container" src="https://drive.google.com/embeddedfolderview?id=12bycs6XiD6zlXIt2gNw9URdvfl0GoTxa#list"></iframe>
    </section>

    <!-- TAB AGREGAR -->
    <section id="agregar" class="tab-content">
      <h2 class="section-title" style="margin-bottom: 1rem;">Agregar Canción</h2>
      <form id="addSongForm" onsubmit="addSong(event)">
        <div class="form-group">
          <label>Título</label>
          <input type="text" id="title" required placeholder="Ej. Cuan Grande es Él">
        </div>
        <div class="form-group">
          <label>Tonalidad</label>
          <input type="text" id="key" required placeholder="Ej. G, Do#, Bb">
        </div>
        <div class="form-group">
          <label>Tempo (BPM)</label>
          <input type="number" id="bpm" placeholder="Ej. 72">
        </div>
        <div class="form-group">
          <label>Enlace Google Drive (PDF / Imagen)</label>
          <input type="url" id="driveUrl" required placeholder="https://drive.google.com/file/d/...">
        </div>
        <button type="submit" class="btn-primary">Guardar en Repertorio</button>
      </form>
    </section>
  </main>

  <!-- NAVEGACIÓN INFERIOR -->
  <nav>
    <button class="nav-btn active" onclick="switchTab('repertorio', this)">
      <span class="icon">🎵</span> Repertorio
    </button>
    <button class="nav-btn" onclick="switchTab('domingo', this)">
      <span class="icon">⭐</span> Domingo
    </button>
    <button class="nav-btn" onclick="switchTab('drive', this)">
      <span class="icon">📁</span> Drive
    </button>
    <button class="nav-btn" onclick="switchTab('agregar', this)">
      <span class="icon">➕</span> Nuevo
    </button>
  </nav>

  <!-- MODAL VISOR -->
  <div id="viewerModal" class="modal">
    <div class="modal-header">
      <h3 id="modalTitle">Partitura</h3>
      <div class="modal-header-actions">
        <button id="modalSundayBtn" class="btn-small" onclick="toggleSundayActiveModal()">⭐ Domingo</button>
        <button class="close-btn" onclick="closeViewer()">&times;</button>
      </div>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>

  <script>
    let currentActiveSongId = null;

    let songs = JSON.parse(localStorage.getItem('worship_songs')) || [
      {
        id: 1,
        title: "Way Maker (Aquí Estás)",
        key: "E",
        bpm: 68,
        driveUrl: "https://drive.google.com/file/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs/view",
        inSunday: true
      },
      {
        id: 2,
        title: "La Bondad de Dios",
        key: "A",
        bpm: 70,
        driveUrl: "https://drive.google.com/file/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs/view",
        inSunday: false
      }
    ];

    function getEmbedUrl(url) {
      const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
      if (match && match[1]) {
        return `https://drive.google.com/file/d/${match[1]}/preview`;
      }
      return url;
    }

    function saveState() {
      localStorage.setItem('worship_songs', JSON.stringify(songs));
    }

    function switchTab(tabId, btnElement) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
      
      document.getElementById(tabId).classList.add('active');
      btnElement.classList.add('active');

      if (tabId === 'repertorio') renderSongs();
      if (tabId === 'domingo') renderSundayList();
    }

    function renderSongs(filter = '') {
      const listContainer = document.getElementById('songsList');
      listContainer.innerHTML = '';

      const filteredSongs = songs.filter(song => 
        song.title.toLowerCase().includes(filter.toLowerCase()) || 
        song.key.toLowerCase().includes(filter.toLowerCase())
      );

      if (filteredSongs.length === 0) {
        listContainer.innerHTML = `
          <div class="empty-state">
            <span>🎶</span>
            <p>No se encontraron canciones.</p>
          </div>`;
        return;
      }

      filteredSongs.forEach(song => {
        const card = document.createElement('div');
        card.className = 'song-card';
        card.innerHTML = `
          <div class="song-info">
            <h3>${song.title}</h3>
            <div class="song-meta">
              <span class="badge key">Tono: ${song.key}</span>
              ${song.bpm ? `<span class="badge">${song.bpm} BPM</span>` : ''}
            </div>
          </div>
          <div class="song-actions">
            <button class="action-btn" title="Ver Partitura" onclick="openViewer(${song.id})">👁️</button>
            <button class="action-btn star ${song.inSunday ? 'active' : ''}" title="Domingo" onclick="toggleSunday(${song.id})">⭐</button>
            <button class="action-btn danger" title="Eliminar" onclick="deleteSong(${song.id})">🗑️</button>
          </div>
        `;
        listContainer.appendChild(card);
      });
    }

    function renderSundayList() {
      const listContainer = document.getElementById('sundayList');
      listContainer.innerHTML = '';

      const sundaySongs = songs.filter(song => song.inSunday);

      if (sundaySongs.length === 0) {
        listContainer.innerHTML = `
          <div class="empty-state">
            <span>⭐</span>
            <p>No hay canciones seleccionadas para el Domingo.<br>Agrega algunas desde el repertorio.</p>
          </div>`;
        return;
      }

      sundaySongs.forEach(song => {
        const card = document.createElement('div');
        card.className = 'song-card';
        card.dataset.id = song.id;
        card.innerHTML = `
          <span class="drag-handle" title="Arrastrar">☰</span>
          <div class="song-info" style="margin-left: 0.5rem;">
            <h3>${song.title}</h3>
            <div class="song-meta">
              <span class="badge key">Tono: ${song.key}</span>
              ${song.bpm ? `<span class="badge">${song.bpm} BPM</span>` : ''}
            </div>
          </div>
          <div class="song-actions">
            <button class="action-btn" title="Ver" onclick="openViewer(${song.id})">👁️</button>
            <button class="action-btn danger" title="Quitar" onclick="toggleSunday(${song.id})">✕</button>
          </div>
        `;
        listContainer.appendChild(card);
      });

      if (window.Sortable) {
        if (listContainer.sortableInstance) {
          listContainer.sortableInstance.destroy();
        }
        listContainer.sortableInstance = Sortable.create(listContainer, {
          animation: 150,
          handle: '.drag-handle',
          onEnd: function () {
            const newSundayIds = Array.from(listContainer.children).map(el => parseInt(el.dataset.id));
            const sundayMap = new Map(songs.filter(s => s.inSunday).map(s => [s.id, s]));
            const nonSundaySongs = songs.filter(s => !s.inSunday);
            const reorderedSunday = newSundayIds.map(id => sundayMap.get(id));

            songs = [...reorderedSunday, ...nonSundaySongs];
            saveState();
          }
        });
      }
    }

    function filterSongs() {
      const query = document.getElementById('searchInput').value;
      renderSongs(query);
    }

    function addSong(e) {
      e.preventDefault();
      const newSong = {
        id: Date.now(),
        title: document.getElementById('title').value,
        key: document.getElementById('key').value,
        bpm: document.getElementById('bpm').value || null,
        driveUrl: document.getElementById('driveUrl').value,
        inSunday: false
      };

      songs.push(newSong);
      saveState();
      document.getElementById('addSongForm').reset();
      
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
      document.getElementById('repertorio').classList.add('active');
      document.querySelector('nav button').classList.add('active');
      renderSongs();
    }

    function toggleSunday(id) {
      songs = songs.map(song => song.id === id ? {...song, inSunday: !song.inSunday} : song);
      saveState();
      renderSongs();
      renderSundayList();
      if (currentActiveSongId === id) {
        updateModalSundayButton();
      }
    }

    function toggleSundayActiveModal() {
      if (currentActiveSongId !== null) {
        toggleSunday(currentActiveSongId);
      }
    }

    function updateModalSundayButton() {
      const song = songs.find(s => s.id === currentActiveSongId);
      const btn = document.getElementById('modalSundayBtn');
      if (song && song.inSunday) {
        btn.classList.add('active');
        btn.innerText = '★ En Domingo';
      } else {
        btn.classList.remove('active');
        btn.innerText = '⭐ Domingo';
      }
    }

    function deleteSong(id) {
      if (confirm('¿Deseas eliminar esta canción del repertorio?')) {
        songs = songs.filter(song => song.id !== id);
        saveState();
        renderSongs();
        renderSundayList();
      }
    }

    function openViewer(id) {
      const song = songs.find(s => s.id === id);
      if (!song) return;

      currentActiveSongId = id;
      document.getElementById('modalTitle').innerText = song.title;
      updateModalSundayButton();

      const modalBody = document.getElementById('modalBody');
      const embedUrl = getEmbedUrl(song.driveUrl);

      modalBody.innerHTML = `<iframe src="${embedUrl}" allow="autoplay"></iframe>`;
      document.getElementById('viewerModal').style.display = 'flex';
    }

    function closeViewer() {
      document.getElementById('viewerModal').style.display = 'none';
      document.getElementById('modalBody').innerHTML = '';
      currentActiveSongId = null;
    }

    renderSongs();
  </script>
</body>
</html>
